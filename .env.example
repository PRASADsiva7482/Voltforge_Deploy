# =============================================================================
# VoltForge Azure Deployment — Environment Configuration
# =============================================================================

# ── Database Configuration ───────────────────────────────────────────────────
# Azure Database for MySQL Flexible Server (Burstable B1ms Free Tier)
VOLTFORGE_DB_URL=jdbc:mysql://mysql-voltforge-prod-001.mysql.database.azure.com:3306/voltforge_db?sslMode=REQUIRED&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
VOLTFORGE_DB_USERNAME=voltadmin
VOLTFORGE_DB_PASSWORD=<YOUR_MYSQL_PASSWORD>

# (Alternative: External MySQL database template)
# VOLTFORGE_DB_URL=jdbc:mysql://<HOST>:<PORT>/voltforge_db?sslMode=REQUIRED&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
# VOLTFORGE_DB_USERNAME=<USERNAME>
# VOLTFORGE_DB_PASSWORD=<PASSWORD>

# ── Keycloak Database ─────────────────────────────────────────────────────────
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=<KEYCLOAK_DB_PASSWORD>

# ── Keycloak Admin Credentials ───────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<KEYCLOAK_ADMIN_PASSWORD>

# ── Keycloak Application Client ──────────────────────────────────────────────
KEYCLOAK_REALM=voltforge-realm
KEYCLOAK_CLIENT_ID=VOLT-Canvas
KEYCLOAK_CLIENT_SECRET=BpJfF6q1sdld27MOOXonOFC84GZlHyrC

# Enable Keycloak security validation in Backend API (true/false)
KEYCLOAK_ENABLED=false

# ── AI Microservice ──────────────────────────────────────────────────────────
VOLTFORGE_AI_PORT=2002
